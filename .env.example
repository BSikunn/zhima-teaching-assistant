# Local transition mode: no paid API calls until AI_MODE=deepseek is selected.
AI_MODE=demo
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
TASK_MODE=eager
STORAGE_BACKEND=local
RETRIEVAL_BACKEND=keyword
# Optional local paths and services (absolute paths recommended on Windows).
# DATA_DIR=D:/your-project/data
# DATABASE_URL=mysql+pymysql://user:URL_ENCODED_PASSWORD@127.0.0.1:3306/zhima?charset=utf8mb4
# JWT_SECRET=
# REDIS_URL=redis://127.0.0.1:6379/0
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=zhima
# MINIO_SECURE=false
# INDEX_URL=http://127.0.0.1:8767
# INDEX_TOKEN=
# EMBEDDING_MODEL_PATH=D:/your-project/models/bge-small-zh-v1.5
# JUDGE0_URL=
# JUDGE0_KEY=
# Compose private credentials are generated into .env.compose, never copied to the frontend.

# Real no-key search; network failure still permits model-knowledge answers.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=ddgs
WEB_SEARCH_BACKEND=yahoo
WEB_SEARCH_TIMEOUT=10
WEB_SEARCH_MAX_RESULTS=3
